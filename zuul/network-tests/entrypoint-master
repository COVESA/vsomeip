#!/usr/bin/env bash

set -eu

# Enable timestamps for all commands (works with -x flag)
export PS4='+ [$(date "+%Y-%m-%d %H:%M:%S")] '

source "${BASH_SOURCE[0]%/*}"/shlib/common.shlib
source "${BASH_SOURCE[0]%/*}"/shlib/results.shlib

# Ensure /run/netns is a shared mount so `ip netns add` inside test processes
# doesn't need to call `mount --make-shared` (which may be denied by LSM).
mkdir -p /run/netns
if ! mountpoint -q /run/netns; then
	mount --bind /run/netns /run/netns
fi
mount --make-shared /run/netns

# Sandbox overlay IPs — distinct from the Docker macvlan network (169.254.87.0/24)
# so that VXLAN route setup on the slave cannot interfere with underlay connectivity.
# Master: 10.99.0.254, Slaves: 10.99.0.1, 10.99.0.2, ...
export SANDBOX_MASTER_IP="10.99.0.254"
export SANDBOX_SLAVE_IP="10.99.0.1"
export SANDBOX_SLAVE_2ND_IP="10.99.0.2"

# Path to shared directory for tests, available in the host-side sandbox as well as assigned slave container(s).
# On the host, it is mapped to a unique temporary directory.
export TEST_SHARED_DIR="/home/shared"

# Stress label extraction
# 1. We convert the incoming JSON-encoded array of labels into an object by
#    using regex capture to extract the key/value from the format
#    "<key> : <value>", with spaces around the colon being optional
# 2. The `stress_regex` is available on key "ctest-include"
# 3. The `stress_times` are extracted to a Bash array
#    a) The value of key "ctest-stress" is split on "-" (format "N-M")
#    b) Each split token is converted into a JSON number or defaults to 1 if
#       conversion fails
#    c) Resulting array is bumped with an extra 1 to ensure at least 2 elements
#    d) Slice array to extract first 2 elements
stress_labels_json=$(jq 'map(capture("(?<key>[^:\\s]+)\\s*:\\s*(?<value>[^:\\s]+)")) | from_entries' <<<"$STRESS_LABELS")
stress_regex=$(jq -r '.["ctest-include"] // ""' <<<"$stress_labels_json")
mapfile -t stress_times < <(jq -r '.["ctest-stress"] // "1-1" | split("-") | map(try tonumber catch 1) + [1] | .[:2][]' <<<"$stress_labels_json")

(
	cmake --preset ci-network-tests \
		-D "ENABLE_SANITIZERS=${ENABLE_SANITIZERS}" \
		-D "ENABLE_THREAD_SANITIZER=${ENABLE_THREAD_SANITIZER}" \
		-D "TEST_IP_MASTER=$SANDBOX_MASTER_IP" \
		-D "TEST_IP_SLAVE=$SANDBOX_SLAVE_IP" \
		-D "TEST_IP_SLAVE_SECOND=$SANDBOX_SLAVE_2ND_IP" \
		-D "TEST_SHARED_DIR=${TEST_SHARED_DIR}" \
		-D "VALGRIND_LOGS_DIR=/home/logs/valgrind/$VALGRIND_TYPE" \
		-D "VALGRIND_SUPPRESS_FILE=/home/source/zuul/network-tests/valgrind/$VALGRIND_TYPE.supp" \
		-D "VALGRIND_TYPE=$VALGRIND_TYPE" \
		-D "DISABLE_DLT=ON"
	cmake --build --preset ci-network-tests
)

tests_result_file=/home/logs/tests_result.json
declare -i valgrind_errors=0
mkdir -p /home/logs/{cores,coverage,{,failed-}junit,pcap,"valgrind/$VALGRIND_TYPE"}
gen-result-file "$tests_result_file" "/home/source/.tests-whitelist"

# Enable pcap capture inside each test's network namespace.
export PCAP_DIR=/home/logs/pcap

PARALLEL_JOBS="$(nproc --all)"
echo "Running tests with up to $PARALLEL_JOBS parallel jobs..."

# Build CTest resource spec file with one instance per slave, identified by IP
resource_spec_file=/home/build/resource-specs.json
mapfile -t slave_ips < <(dig slave +short)
instances_json=$(
	for ip in "${slave_ips[@]}"; do
		id="${ip//./_}" # dots are not valid in CTest resource IDs; replace with underscores
		printf '{"id": "%s", "slots": 1}\n' "$id"
	done | jq -s '.'
)
jq -n --argjson instances "$instances_json" \
	'{"version": {"major": 1, "minor": 0}, "local": [{"slaves": $instances}]}' \
	>"$resource_spec_file"
echo "Generated resource spec at $resource_spec_file with ${#slave_ips[@]} slave(s)."

for ((n = 0; n < stress_times[0]; n++)); do
	# clear leftovers from a previous run
	rm -f /home/build/Testing/Temporary/CTestCostData.txt

	if is-timed-out; then
		break
	fi

	# Only override the preset's repeat setting when stress demands more than 1 repetition.
	ctest_repeat=()
	if ((stress_times[1] > 1)); then
		ctest_repeat=(--repeat "until-fail:${stress_times[1]}")
	fi

	# Only override the preset's test filter when stress demands a specific regex.
	ctest_filter=()
	if [[ -n "$stress_regex" ]]; then
		ctest_filter=(--tests-regex "$stress_regex")
	fi

	ctest --preset ci-network-tests -j "${PARALLEL_JOBS}" \
		--resource-spec-file "$resource_spec_file" \
		"${ctest_repeat[@]}" \
		"${ctest_filter[@]}" || true
	cp /home/build/Testing/Temporary/LastTest.log /home/logs/junit/all.log

	# `all.log` contains output for multiple tests, so split it into per-test files.
	# The expected format is:
	# ```
	# 11/193 Testing: configuration_test
	# 11/193 Test: configuration_test
	# Command: ...
	# Directory: ...
	# Output:
	# ----------------------------------------------------------
	# random-test-output
	# ----------------------------------------------------------
	# Test Passed.
	# "configuration_test" end time: ...
	# "configuration_test" time elapsed: ...
	# ----------------------------------------------------------
	# 18/193 Testing: dispatch_app_stop_test
	# 18/193 Test: dispatch_app_stop_test
	# ...
	# ```
	awk '
		/^[0-9]+\/[0-9]+ Testing:/ {
			if (testname) close(outfile)
			gsub(/.*Testing: /, ""); gsub(/$/, "")
			testname = $0
			outfile = "/home/logs/junit/" testname ".log"
		}
		testname { print > outfile }
	' /home/logs/junit/all.log

	# Report individual test failures/successes from CTestCostData.txt.
	#
	# CTestCostData.txt format:
	#   NF==3 section: "testname exec_count cost" for ALL tests that ran (pass + fail)
	#   NF==1 section: "testname" for FAILED tests (after "---" separator)
	#
	# A ctest-failing test appears in BOTH sections. We build two membership sets —
	# _ctest_failed (NF==1) and _nf3_seen (NF==3) — then process every NF==3 test
	# exactly once. A safety-net pass then handles any NF==1 tests not in NF==3
	# (pathological ctest output: file truncated or test crashed before cost was written).
	declare -A _ctest_failed
	while read -r testcase; do
		_ctest_failed["$testcase"]=1
	done < <(awk 'NF==1 {print $1}' /home/build/Testing/Temporary/CTestCostData.txt | tail -n +2)

	declare -A _nf3_seen
	while read -r testcase; do
		_nf3_seen["$testcase"]=1
		valgrind_errors=0
		if [[ "$VALGRIND_TYPE" ]]; then
			valgrind_errors=$(valgrind-errors "/home/logs/valgrind/$VALGRIND_TYPE" "$testcase")
		fi

		if ((valgrind_errors > 0)); then
			update-result-file "$tests_result_file" "$testcase" "$valgrind_errors" "$VALGRIND_TYPE"
			cp /home/logs/{junit/"$testcase".log,failed-junit/} 2>/dev/null || :
		fi

		if [[ "${_ctest_failed[$testcase]+x}" ]]; then
			update-result-file "$tests_result_file" "$testcase" 1
			cp /home/logs/{junit/"$testcase".log,failed-junit/} 2>/dev/null || :
		elif ((valgrind_errors == 0)); then
			update-result-file "$tests_result_file" "$testcase"
		fi
	done < <(awk 'NF==3 {print $1}' /home/build/Testing/Temporary/CTestCostData.txt)

	# Safety net: record any ctest-failed tests absent from the NF==3 section.
	# This handles pathological ctest output where the file was truncated or a
	# test crashed before its cost entry was written.
	for testcase in "${!_ctest_failed[@]}"; do
		if [[ ! "${_nf3_seen[$testcase]+x}" ]]; then
			valgrind_errors=0
			if [[ "$VALGRIND_TYPE" ]]; then
				valgrind_errors=$(valgrind-errors "/home/logs/valgrind/$VALGRIND_TYPE" "$testcase")
			fi
			if ((valgrind_errors > 0)); then
				update-result-file "$tests_result_file" "$testcase" "$valgrind_errors" "$VALGRIND_TYPE"
			fi
			update-result-file "$tests_result_file" "$testcase" 1
			cp /home/logs/{junit/"$testcase".log,failed-junit/} 2>/dev/null || :
		fi
	done
	unset _ctest_failed _nf3_seen
done

(
	cd /home/logs
	tar -acvf junit.tgz --transform=s/^junit/network-tests/ junit/*.log
	shopt -s nullglob
	if [[ "$(echo failed-junit/*.log)" ]]; then
		tar -acvf failed-junit.tgz --transform=s/^failed-junit/network-tests/ failed-junit/*.log
	fi
)

gen-core-backtraces /home/logs/cores master
run-slave bash -lc 'source /home/source/zuul/network-tests/shlib/results.shlib; gen-core-backtraces /home/logs/cores @name@' || :

if [ "$ENABLE_COVERAGE" != False ]; then
	# All containers share /home/build and /home/source via bind mounts, so .gcda
	# files from every test execution (regardless of which container ran it) are
	# already in /home/build. A single gcovr/lcov invocation on master suffices.
	# Running on multiple slaves in parallel would race on intermediate .gcov files
	# in the shared /home/source working directory.
	gcovr -j 0 --merge-mode-functions=merge-use-line-0 --gcov-executable "$GCOV" --gcov-ignore-parse-errors=suspicious_hits.warn --json /home/logs/coverage.json --root /home/source /home/build
	lcov --base-directory /home/source --capture --directory /home/build --gcov-tool "$GCOV" --ignore-errors mismatch --output-file /home/logs/coverage/merged.info
	lcov --remove /home/logs/coverage/merged.info '/usr/*' --output-file /home/logs/coverage/filtered.info
	genhtml --output-directory /home/logs/coverage/html --prefix /home/source /home/logs/coverage/filtered.info
fi

run-slave kill 1 || :

print-results "$tests_result_file"
if is-timed-out; then
	echo 'Global timeout was reached!'
	echo 'See above which test(s) were at fault.'
	exit 255
else
	exit "$(jq '.exit_error' "$tests_result_file")"
fi
