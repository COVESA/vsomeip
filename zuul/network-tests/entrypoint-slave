#!/bin/bash -eu

source "${BASH_SOURCE[0]%/*}"/shlib/common.shlib

# The ephemeral local port range is narrowed via docker-compose.yaml sysctls so
# the kernel never hands out the fixed SOME/IP test ports as ephemeral source
# ports. The slave runs in its container namespace, so no re-apply is needed here.

mkdir -p /run/sshd
exec /sbin/sshd -D
