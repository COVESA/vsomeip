{
    "unicast":"@TEST_IP_MASTER@",
    "netmask":"255.255.255.0",
    "diagnosis":"0x01",
    "logging":
    {
        "level":"trace",
        "console":"true"
    },
    "tracing" :
    {
        "enable" : "true"
    },
    "applications":
    [
        {
            "name":"big_payload_test_client",
            "max_dispatchers":"1",
            "max_dispatch_time":"5000"
        }
    ],
    "services":
    [
        {
            "service":"0x1240",
            "instance":"0x01",
            "unreliable": "30509",
            "someip-tp" : {
                "client-to-service" : [ "0x8421" ]
            }
        }
    ],
    "max-payload-size-reliable":"614400",
    "routing":"big_payload_test_client",
    "service-discovery":
    {
        "enable":"true"
    }
}
