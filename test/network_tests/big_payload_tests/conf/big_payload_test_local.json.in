{
    "unicast":"127.0.0.1",
    "logging":
    {
        "level":"trace",
        "console":"true"
    },
    "tracing" :
    {
        "enable" : "true"
    },
    "applications":
    [
        {
            "name":"big_payload_test_client",
            "max_dispatchers":"1",
            "max_dispatch_time":"5000"
        }
    ],
    "services":
    [
        {
            "service":"0x1234",
            "instance":"0x5678"
        }
    ],
    "payload-sizes":
    [
        {
            "unicast":"127.0.0.1",
            "ports":
            [
                {
                    "port":"30509",
                    "max-payload-size":"614400"
                }
            ]
        }
    ],
    "routing":"big_payload_test_service",
    "service-discovery":
    {
        "enable":"true"
    }
}
