{
    "unicast":"127.0.0.1",
    "diagnosis":"0x01",
    "logging":
    {
        "level":"trace",
        "console":"true"
    },
    "tracing" :
    {
        "enable" : "true"
    },
    "applications":
    [
        {
            "name":"big_payload_test_client",
            "max_dispatchers":"1",
            "max_dispatch_time":"5000"
        }
    ],
    "services":
    [
        {
            "service":"0x1234",
            "instance":"0x5678"
        }
    ],
    "endpoint-queue-limit-local" : "614500",
    "routing":
    {
        "host" :
        {
            "name" : "big_payload_test_service",
            "unicast" : "@TEST_IP_SLAVE@",
            "port" : "31490"
        },
        "guests" :
        {
            "unicast" : "@TEST_IP_MASTER@"
        }
    },
    "service-discovery":
    {
        "enable":"true"
    }
}
