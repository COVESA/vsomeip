{
    "unicast":"@TEST_IP_MASTER@",
    "netmask":"255.255.255.0",
    "diagnosis":"0x01",
    "logging":
    {
        "level":"trace",
        "console":"true"
    },
    "tracing" :
    {
        "enable" : "true"
    },
    "applications":
    [
        {
            "name":"big_payload_test_client",
            "max_dispatchers":"1",
            "max_dispatch_time":"5000"
        }
    ],
    "payload-sizes":
    [
        {
            "unicast":"@TEST_IP_SLAVE@",
            "ports":
            [
                {
                    "port":"30509",
                    "max-payload-size":"614400"
                }
            ]
        }
    ],
    "routing":"big_payload_test_client",
    "service-discovery":
    {
        "enable":"true"
    }
}
