{
    "unicast": "127.0.0.1",
    "netmask": "255.255.255.0",
    "logging": {
        "level": "trace",
        "console": "true"
    },
    "tracing": {
        "enable": "true"
    },
    "services": [
        {
            "service": "0x1234",
            "instance": "0x5678",
            "unreliable": "30509"
        }
    ],
    "routing": "routingmanagerd",
    "service-discovery": {
        "enable": "false"
    }
}
