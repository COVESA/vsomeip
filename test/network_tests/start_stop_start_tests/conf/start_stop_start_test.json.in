{
    "unicast":"@TEST_IP_MASTER@",
    "logging":
    {
        "level":"trace",
        "console":"true"
    },
    "tracing" :
    {
        "enable" : "true"
    },
    "routing":
    {
        "host":
        {
            "name":"routingmanagerd",
            "unicast":"@TEST_IP_MASTER@",
            "port":"13000"
        }
    },
    "service-discovery":
    {
        "enable":"false",
        "cyclic_offer_delay":"20000",
        "ttl":"3"
    }
}
