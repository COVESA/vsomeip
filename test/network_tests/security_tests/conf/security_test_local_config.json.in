{
    "unicast" : "localhost",
    "logging" :
    {
        "level" : "trace",
        "console" : "true"
    },
    "tracing" :
    {
        "enable" : "true"
    },
    "security" :
    {
        "check_credentials" : "true",
        "policies" :
        [
            {
                "credentials" : { "uid" : "@TEST_UID@", "gid" : "@TEST_GID@" },
                "allow" :
                {
                    "offers":
                    [
                        {
                            "service"  : "0x1234",
                            "instance" : "0x5678"
                        }
                    ],
                    "requests":
                    [
                        {
                            "service"  : "0x1234",
                            "instances" :
                            [
                                {
                                    "ids" : ["0x5678"],
                                    "methods" : [ {"first" : "0x8421", "last" : "0x8422" }, "0x8001", "0x7777" ]
                                }
                            ]
                        }
                    ]
                }
            }
        ]
    },
    "routing" : "routingmanagerd",
    "routing-credentials" :
    {
        "uid" : "@TEST_UID@",
        "gid" : "@TEST_GID@"
    },
    "service-discovery" :
    {
        "enable" : "true"
    }
}
