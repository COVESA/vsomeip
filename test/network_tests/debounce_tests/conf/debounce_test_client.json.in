{
  "unicast" : "@TEST_IP_MASTER@",
  "logging": {
    "level": "trace",
    "console": "true"
  },
  "tracing":
  {
    "enable": "true"
  },
  "debounce":
  [
      {
          "service" : "0xb657",
          "instance" : "0x0003",
          "events" :
          [
              {
                  "event" : "0x8001",
                  "on_change" : "true",
                  "ignore" :
                  [
                      0, 5
                  ]
              },
              {
                  "event" : "0x8002",
                  "on_change" : "true",
                  "ignore" :
                  [
                      0, 5, 7, 8, 9, 10
                  ]
              },
              {
                  "event" : "0x8004",
                  "on_change" : "true",
                  "ignore" :
                  [
                     {
                         "index" : "0",
                         "mask" : "0x0f"
                     },
                     {
                         "index" : "5",
                         "mask" : "0xfe"
                     }
                  ]
              }
          ]
      }
  ],
  "routing": "routingmanagerd",
  "service-discovery" :
   {
      "enable" : "true"
   }
}
