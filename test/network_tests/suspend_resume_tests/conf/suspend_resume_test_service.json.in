{
    "unicast" : "@TEST_IP_MASTER@",
    "diagnosis":"0x01",
    "netmask" : "255.255.255.0",
    "logging" :
    {
        "level" : "trace",
        "console" : "true"
    },
    "tracing" :
    {
        "enable" : "true"
    },
    "services" :
    [
        {
            "service" : "0x6311",
            "instance" : "0x0002",
            "unreliable" : "34504"
        }
    ],
    "routing" : "routingmanagerd",
    "service-discovery" :
    {
        "enable" : "true",
        "initial_delay_min" : "50",
        "initial_delay_max" : "50",
        "repetitions_base_delay" : "30",
        "repetitions_max" : "3",
        "ttl" : "3"
    }
}
