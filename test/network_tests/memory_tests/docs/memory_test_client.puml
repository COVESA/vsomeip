@startuml
  Actor service_consumer as SC

  participant routing_manager as RM

  SC -> RM : REQUEST

  RM --\ SC : ON_AVAILABLE

  SC -> RM : SUBSCRIBE

  RM --\ SC : SUBSCRIBE_ACK

  SC -> SC : capture pre-traffic RSS baseline (reference only)

  SC -> RM : REQUEST MEMORY_START_METHOD

  loop while stop_watchdog is false
    SC -> SC : sleep WATCHDOG_INTERVAL (2s)

    SC -> SC : log throughput; measure time since\nlast message received

    alt no message for > CONSUMER_IDLE_TIMEOUT (10s)
      SC -> SC : stop_watchdog = true
    end
  end

  note across
    This happens in background during the test
  endnote

  loop while stop_checking_ is false
    SC -> SC : sleep MEMORY_CHECKER_INTERVAL (5s)

    SC -> SC : read /proc/self/statm (skip failed reads)

    SC -> SC : save Resident set size * page size
  end

  note across
    Evaluated on the main thread after the checker joins
  endnote

  SC -> SC : make sure the peak sample in\ntest_memory_array is smaller than\n115% of the steady-state floor\n(min sample, first one excluded)

  SC -> RM : REQUEST MEMORY_STOP_METHOD (on teardown)

  note across
    On each received notification (background)
  endnote

  RM --\ SC : notification (MEMORY_EVENT + i)

  SC -> SC : verify serviceID/methodID,\nincrement received counter

  alt every ACK_INTERVAL messages
    SC -> RM : REQUEST MEMORY_ACK_METHOD\n(cumulative received count)
  end
@enduml
